# Copy to .env and adjust as needed.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/foodfen
DB_ECHO=false

# Auth. Generate a real secret for anything but local dev:  openssl rand -hex 32
JWT_SECRET=dev-insecure-secret-change-me-in-production-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Origin used to build the verification link sent by email.
APP_BASE_URL=http://localhost:8000

# Email delivery. "console" just logs the link; "smtp" sends for real.
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@foodfen.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
