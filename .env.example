# Copy to .env and adjust as needed.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/foodfen
DB_ECHO=false

# Auth. Generate a real secret for anything but local dev:  openssl rand -hex 32
JWT_SECRET=dev-insecure-secret-change-me-in-production-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# Origin used to build the verification link sent by email.
APP_BASE_URL=http://localhost:8000

# Comma-separated allowed origins for browser clients, or "*" for any origin.
CORS_ALLOW_ORIGINS=*

# Email delivery. "console" just logs the link; "smtp" sends for real.
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@foodfen.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Social sign-in (POST /auth/social). Comma-separated; an app usually needs
# more than one OAuth client id (iOS + Android, or a bundle id + a Sign In
# with Apple Service ID). Empty = that provider fails closed (500), not open.
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_CLIENT_IDS=

# AI chat (POST /chat/messages).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
CHAT_HISTORY_LIMIT=10

# AI food capture (POST /ai/food/analyze-image|analyze-text). Same Gemini key/model.
# CLOUDINARY_URL is the SDK's own shape: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Payments (POST /payments/*). PayOS merchant credentials from https://my.payos.vn.
# Empty = checkout/webhook fail closed, same as the OAuth client ids.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Frontend/deep-link URLs the user is redirected to after paying — not backend routes.
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=
PAYOS_MONTHLY_PRICE_VND=49000
PAYOS_ANNUAL_PRICE_VND=499000
# MoMo (v2 gateway, captureWallet). Offered only when partner code, both keys and the IPN URL are set.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn
# Where MoMo sends the user after paying: the app's deep link (or an HTTPS bounce to it).
MOMO_REDIRECT_URL=foodfen://premium/return
# Public URL of POST /payments/webhook/momo.
MOMO_IPN_URL=
